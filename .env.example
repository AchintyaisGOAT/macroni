# Gemini API key - required for AI regime narratives and alert explanations.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for AI interpretation (see backend/app/config.py). gemini-3.6-flash is a
# fast, cost-effective default for a job that runs on a recurring schedule; swap in
# gemini-pro-latest (or any model your key has access to) for higher-quality output.
GEMINI_MODEL=gemini-3.6-flash

# FRED API key - required for macro data (CPI, GDP, yields, etc.).
# Free, get one at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
