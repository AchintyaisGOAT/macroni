# FRED API key - required for macro data (CPI, GDP, yields, etc.).
# Free, get one at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Note: AI regime narratives no longer need a local API key - they run through a
# hosted proxy (see backend/app/config.py PROXY_URL) that holds the real Gemini
# key server-side, so this works out of the box for anyone who installs the app.
